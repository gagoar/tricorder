{
  "name": "tricorder",
  "version": "0.1.0",
  "private": true,
  "description": "Always-on Claude Code session panel + attention sounds (personal tool).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node24 --outfile=build/tricorder.cjs",
    "build": "bash build-slim.sh",
    "build:sea": "bash build-sea.sh",
    "build:handler": "bash build-handler.sh",
    "build:bar": "bash build-bar.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.24.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.6.0"
  }
}
