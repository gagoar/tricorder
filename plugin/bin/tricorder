var ACCOUNT_MODES = [AUTO, ...ACCOUNT_TYPES];
function isAccountMode(value) {
  return ACCOUNT_MODES.includes(value);
}
function isDetectedType(value) {
  return DETECTED_TYPES.includes(value);
}
