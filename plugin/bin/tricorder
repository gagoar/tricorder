    const spendNote = type === PAYG && fields2.spend ? [`\u{1F4B0} uses an example budget of $${EXAMPLE_BUDGET_USD}. Set yours with: tricorder budget <dollars>`] : [];
    const note = [...introNote, ...spendNote];
    process.stdout.write([plainText(drawn).trimEnd(), ...note].join("\n") + "\n");
  } finally {
    (0, import_node_fs11.rmSync)(home, { recursive: true, force: true });
  }
}

// src/questions.ts
var ENABLE_ALL_LABEL = "Enable all";
var OPTIONS_PER_QUESTION = 4;
var QUESTIONS_PER_CALL = 4;
var MIN_OPTIONS = 2;
var HEADER_MAX_CHARS = 12;
function firstSentence(text) {
  const end = text.indexOf(". ");
  return end === -1 ? text : text.slice(0, end + 1);
}
function pieces(items, size) {
  return Array.from({ length: Math.ceil(items.length / size) }, (_, i) => items.slice(i * size, (i + 1) * size));
}
function chunk(items) {
  const groups = pieces(items, OPTIONS_PER_QUESTION);
  const lastIndex = groups.length - 1;
  const last = groups[lastIndex];
  const before = groups[lastIndex - 1];
  if (last === void 0 || before === void 0 || last.length >= MIN_OPTIONS) return groups;
  return [...groups.slice(0, lastIndex - 1), before.slice(0, -1), [...before.slice(-1), ...last]];
}
function buildQuestionCalls(fields2) {
  const options = [
    { label: ENABLE_ALL_LABEL, description: "Turn on every field listed." },
    ...fields2.map((f) => ({ label: f.name, description: firstSentence(f.shows) }))
  ];
  const groups = chunk(options);
  const questions = groups.map((group, i) => ({
    question: `Tick the fields you want to see (part ${i + 1} of ${groups.length}). Anything you leave unticked is turned off. Tick at least one; to start over, tick ${ENABLE_ALL_LABEL}.`,
    header: `Fields ${i + 1}`.slice(0, HEADER_MAX_CHARS),
    multiSelect: true,
    options: group
  }));
  return pieces(questions, QUESTIONS_PER_CALL);
}

// src/fieldscmd.ts
var ALL = "all";
function accountTypeFor(arg) {
  if (arg === void 0) return resolveType(loadConfig().statusline.mode, detectAccount().type);
  if (isDetectedType(arg)) return arg;
  process.stderr.write("tricorder: unknown account type: " + arg + "\nvalid: " + DETECTED_TYPES.join(", ") + "\n");
  process.exitCode = 1;
  return null;
}
function detect() {
  const cfg = loadConfig();
  const detected = detectAccount();
  const type = resolveType(cfg.statusline.mode, detected.type);
  process.stdout.write(JSON.stringify({ ...detected, type, mode: cfg.statusline.mode }) + "\n");
}
function describeFields(typeArg) {
  const type = accountTypeFor(typeArg);
  if (type === null) return;
  const cfg = loadConfig();
  const out = fieldsFor(type).map((f) => ({
    id: f.id,
    name: f.name,
    shows: f.shows,
    sample: f.sample,
    legend: f.legend,
    enabled: cfg.statusline.fields[f.id]
  }));
  process.stdout.write(serialize({ type, fields: out }));
}
function questionsFor(typeArg) {
  const type = accountTypeFor(typeArg);
  if (type === null) return;
  const list = fieldsFor(type);
  const labels = Object.fromEntries(list.map((f) => [f.name, f.id]));
  process.stdout.write(serialize({ enableAllLabel: ENABLE_ALL_LABEL, labels, calls: buildQuestionCalls(list) }));
}
function parseFieldList(arg) {
  if (arg.trim().toLowerCase() === ALL) return { ids: FIELD_IDS, unknown: [] };
  const parts = arg.split(",").map((p) => p.trim()).filter(Boolean);
  return { ids: parts.filter(isFieldId), unknown: parts.filter((p) => !isFieldId(p)) };
}
function setFields(arg) {
  const { ids, unknown } = parseFieldList(arg ?? "");
  if (unknown.length) {
    process.stderr.write("tricorder: unknown field(s): " + unknown.join(", ") + "\nvalid: " + FIELD_IDS.join(", ") + "\n");
    process.exitCode = 1;
    return;
  }
  if (!ids.length) {
    process.stdout.write("no fields given; nothing changed\n");
    return;
  }
  const cfg = loadConfig();
  const fields2 = buildFields((id) => ids.includes(id));
  saveConfig({ ...cfg, statusline: { ...cfg.statusline, fields: fields2 } });
  log("fields set \u2192 " + ids.join(","));
  process.stdout.write("on: " + ids.join(", ") + "\n");
}
var SUBCOMMANDS = {
  describe: describeFields,
  questions: questionsFor,
  preview: () => previewFields(),
  [PREVIEW_RENDER]: () => renderPreviewSession(),
  // internal: `preview` runs it in a throwaway home
  set: setFields
};
var USAGE = "usage: tricorder fields describe [type] | fields questions [type] | fields preview | fields set <id,id,...|all>\n";
function isSubCommand(name) {
  return name !== void 0 && Object.hasOwn(SUBCOMMANDS, name);
}
function fields(sub, arg) {
  if (isSubCommand(sub)) return SUBCOMMANDS[sub](arg);
  process.stderr.write(USAGE);
  process.exitCode = 1;
}

// src/main.ts
var CMD_INDEX = 2;
var ARG_INDEX = 3;
var ARG2_INDEX = 4;
var ARG3_INDEX = 5;
var EXIT_ERR = 1;
var COMMANDS = {
  statusline: () => renderStatusline(readStdin()),
  capture: () => capture(readStdin()),
  sound: () => playSound(process.argv[ARG_INDEX], readStdin()),
  mute: () => mute(process.argv[ARG_INDEX]),
  "worktree-click": () => worktreeClick(process.argv[ARG_INDEX]),
  detect: () => detect(),
  budget: () => budget(process.argv[ARG_INDEX]),
  fields: () => fields(process.argv[ARG_INDEX], process.argv[ARG2_INDEX]),
  warp: () => warp(),
  logs: () => showLogs(process.argv[ARG_INDEX]),
  status: () => status(),
  ack: () => ack(process.argv[ARG_INDEX]),
  "sound-enable": () => soundEnable(process.argv[ARG_INDEX], process.argv[ARG2_INDEX]),
  "sound-set": () => soundSet(process.argv[ARG_INDEX], process.argv[ARG2_INDEX], process.argv[ARG3_INDEX])
};
async function main() {
  const cmd = process.argv[CMD_INDEX] ?? "";
  const run2 = COMMANDS[cmd];
  if (run2 === void 0) {
    process.stderr.write("tricorder: unknown command '" + cmd + "'\n");
    process.exit(EXIT_ERR);
  }
  try {
    await run2();
  } catch (err) {
    process.stderr.write("tricorder: " + String(err) + "\n");
  }
}
void main();
