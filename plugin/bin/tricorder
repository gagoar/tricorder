// src/pace.ts
var PACE_STYLES = {
  early: { name: "Just started", color: 90, icon: "\u{1F9A5}" },
  // grey: too early in the window to tell
  chill: { name: "Chill", color: 32, icon: "\u{1F422}" },
  // green
  onTrack: { name: "On track", color: 94, icon: "\u{1F415}" },
  // blue
  watchOut: { name: "Watch out", color: "38;5;214", icon: "\u{1F40E}" },
  // orange
  hot: { name: "Hot", color: 91, icon: "\u{1F985}" },
  // red; the eagle is the closest emoji to a hawk
  over: { name: "Over", color: 95, icon: "\u{1F409}" }
  // magenta
};
var DEFAULT_PACE = { marginPts: 10, minElapsedPct: 3 };
var FIVE_HOUR_WINDOW_S = 18e3;
var SEVEN_DAY_WINDOW_S = 604800;
var PCT_MAX = 100;
var MS_PER_S = 1e3;
var WATCH_OUT_MARGINS = 2;
function elapsedPct(resetsAtS2, nowS, windowS) {
  return (1 - (resetsAtS2 - nowS) / windowS) * PCT_MAX;
}
function resetsAtS(elapsedPctGone, nowS, windowS) {
  return nowS + (1 - elapsedPctGone / PCT_MAX) * windowS;
}
function bandForDeviation(deviationPts, marginPts) {
  if (deviationPts < -marginPts) return "chill";
  if (deviationPts <= marginPts) return "onTrack";
  if (deviationPts <= WATCH_OUT_MARGINS * marginPts) return "watchOut";
  return "hot";
}
function paceBand(usedPct, elapsed, cfg) {
  if (elapsed === null || elapsed > PCT_MAX) return null;
  if (elapsed < cfg.minElapsedPct) return "early";
  return bandForDeviation(usedPct - elapsed, cfg.marginPts);
}
function budgetBand(usedPct, elapsed, cfg) {
  return usedPct > PCT_MAX ? "over" : paceBand(usedPct, elapsed, cfg);
}
function limitBand(usedPct, elapsed, cfg) {
  return usedPct >= PCT_MAX ? "over" : paceBand(usedPct, elapsed, cfg);
}

